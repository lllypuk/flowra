# Copy to ~/.config/systemd/user/leadfeed-sync.service and adjust the paths.
[Unit]
Description=Publish the lead task snapshot into the Flowra feed

[Service]
Type=oneshot
WorkingDirectory=%h/projects/lllypuk/flowra
Environment=LEAD_TASK=%h/projects/lead/bin/lead-task
ExecStart=%h/projects/lllypuk/flowra/scripts/leadfeed-sync.sh
MemoryMax=512M
