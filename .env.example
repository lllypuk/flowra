# Application
SERVER_PORT=8080
FLOWRA_WORKER=true

# MongoDB (the app runs on the host network and reaches it on loopback)
MONGODB_URI=mongodb://flowra:your-mongodb-password@localhost:27017/?directConnection=true&authSource=admin
MONGODB_DATABASE=flowra
MONGODB_ROOT_USERNAME=flowra
MONGODB_ROOT_PASSWORD=

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Auth: hex SHA-256 of a random owner token; the server listens on loopback only
#   token=$(openssl rand -hex 32); printf %s "$token" | sha256sum
AUTH_OWNER_TOKEN_SHA256=

# Logging
LOG_LEVEL=info
